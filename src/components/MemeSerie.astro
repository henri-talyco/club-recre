---
/**
 * Maillage interne automatique, en bas de chaque article.
 *
 * Pourquoi (02/10/2026) : 75 articles sur 122 n'avaient jamais ete montres par Google,
 * la plupart « detectee, actuellement non indexee » : Google les connait mais ne
 * prend pas la peine de les lire. Les pages d'une meme grille (livres 3 ans, 4 ans,
 * 5 ans ; activites Lyon 1 an, 2 ans, 3 ans) ne se citaient pas entre elles. Ce bloc
 * relie chaque page a sa serie et a ses voisines de sujet, y compris depuis les pages
 * qui marchent, ce qui pousse Google a explorer les autres.
 *
 * 22/10/2026 : le bloc « À lire aussi » (3 a 4 articles) donne la priorite aux pages que
 * Google n'a pas lues, et les articles qui parlent d'une marque renvoient a sa fiche.
 * Tout se calcule dans src/lib/maillage.ts ; le texte des articles n'est pas touche.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { maillageDuSite, motif } from "../lib/maillage";

interface Props {
  entry: CollectionEntry<"articles">;
}
const { entry } = Astro.props;
const tous = await getCollection("articles");

// Le calcul est fait une fois pour tout le site (src/lib/maillage.ts) : « À lire aussi »
// donne la priorite aux pages que Google n'a pas lues (src/data/pages-non-lues.json).
const { serie, memeVille, aLireAussi: voisines, marques } = maillageDuSite(tous).get(entry.slug)!;
const ici = motif(entry.slug);

const libelle = (a: CollectionEntry<"articles">) => a.data.title;
---
{(serie.length > 0 || memeVille.length > 0 || voisines.length > 0 || marques.length > 0) && (
  <nav class="mt-16 pt-10 border-t-2 border-vert-recre" aria-label="Articles de la même série">
    {serie.length > 0 && (
      <section class="mb-8">
        <h2 class="font-fraunces text-2xl font-bold mb-4">Dans la même série</h2>
        <ul class="space-y-2">
          {serie.map((a) => (
            <li><a href={`/journal/${a.slug}/`} class="text-vert-recre underline underline-offset-4 hover:text-orange-sirop">{libelle(a)}</a></li>
          ))}
        </ul>
      </section>
    )}
    {memeVille.length > 0 && (
      <section class="mb-8">
        <h2 class="font-fraunces text-2xl font-bold mb-4">Toujours à {ici.ville!.charAt(0).toUpperCase() + ici.ville!.slice(1)}</h2>
        <ul class="space-y-2">
          {memeVille.map((a) => (
            <li><a href={`/journal/${a.slug}/`} class="text-vert-recre underline underline-offset-4 hover:text-orange-sirop">{libelle(a)}</a></li>
          ))}
        </ul>
      </section>
    )}
    {voisines.length > 0 && (
      <section class={marques.length > 0 ? "mb-8" : ""}>
        <h2 class="font-fraunces text-2xl font-bold mb-4">À lire aussi</h2>
        <ul class="space-y-2">
          {voisines.map((a) => (
            <li><a href={`/journal/${a.slug}/`} class="text-vert-recre underline underline-offset-4 hover:text-orange-sirop">{libelle(a)}</a></li>
          ))}
        </ul>
      </section>
    )}
    {marques.length > 0 && (
      <section>
        <h2 class="font-fraunces text-2xl font-bold mb-4">{marques.length > 1 ? "Les fiches des marques citées" : "La fiche de la marque citée"}</h2>
        <ul class="space-y-2">
          {marques.map((m) => (
            <li><a href={`/marques/${m.slug}/`} class="text-vert-recre underline underline-offset-4 hover:text-orange-sirop">{m.nom} : son histoire, son époque dorée, comment reconnaître une vraie pièce</a></li>
          ))}
        </ul>
      </section>
    )}
  </nav>
)}
