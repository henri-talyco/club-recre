---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  pillar?: string;
  tags?: string[];
  faq?: { q: string; a: string }[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...props} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Clic vers une boutique (lien retouché au build par src/lib/marchands.mjs) :
      // événement GA4 « clic_marchand », la mesure de l'intérêt pour un produit.
      document.addEventListener("click", (e) => {
        const lien = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a[data-marchand]");
        if (!lien) return;
        const gtag = (window as any).gtag;
        if (typeof gtag !== "function") return;
        gtag("event", "clic_marchand", {
          marchand: lien.dataset.marchand,
          produit: lien.dataset.produit,
          page: window.location.pathname,
        });
      });
    </script>

    <script>
      // Newsletter : chaque inscription devient une carte Slack dans #client-club-recre,
      // par le robot Leads de Taly (02/10/2026). Avant, le formulaire n'était branché à
      // rien : Web3Forms n'avait jamais reçu sa clé, et l'inscrit voyait « en cours
      // d'activation ». Le robot ne garde rien, le canal Slack fait office de liste.
      // Envoi en text/plain : pas de requête préalable du navigateur, pas de réponse à lire.
      const ROBOT_LEADS = "https://vz4k5hqjidlqx7c2z5y7sm2r6y0fwppn.lambda-url.eu-west-3.on.aws/";
      const CLES_SOURCE = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "gclid", "fbclid", "msclkid", "ttclid"];

      document.querySelectorAll<HTMLFormElement>("form.js-newsletter-form").forEach((form) => {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (!emailInput || !button) return;
          const email = emailInput.value.trim();
          if (!email) return;

          const parametres = new URLSearchParams(window.location.search);
          const source: Record<string, string> = {};
          CLES_SOURCE.forEach((c) => { const v = parametres.get(c); if (v) source[c] = v; });
          const lignes = document.referrer && !document.referrer.startsWith(window.location.origin)
            ? [`Venu de ${new URL(document.referrer).hostname}`] : [];

          button.disabled = true;
          button.textContent = "...";
          try {
            await fetch(ROBOT_LEADS, {
              method: "POST",
              mode: "no-cors",
              headers: { "Content-Type": "text/plain" },
              body: JSON.stringify({
                client: "clubrecre",
                formulaire: "newsletter",
                page_libelle: window.location.pathname === "/" ? "Accueil" : document.title.split(" | ")[0],
                page: window.location.href.split("?")[0],
                contact: { email },
                lignes,
                source,
                site_web: "",
              }),
            });
            form.innerHTML =
              '<p class="font-fraunces text-lg">Merci ! Tu fais partie du Club. La première lettre arrive bientôt.</p>';
            const gtag = (window as any).gtag;
            if (typeof gtag === "function") gtag("event", "sign_up", { method: "newsletter", page: window.location.pathname });
          } catch (err) {
            alert("Connexion impossible. Réessaie dans un instant.");
            button.disabled = false;
            button.textContent = "Réessayer";
          }
        });
      });
    </script>
  </body>
</html>
